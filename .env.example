# Copie para .env (docker compose) ou cadastre cada linha em
# Portainer > Stacks > fabrica-apps > Environment variables.
# NUNCA commite o .env.

# ---------------------------------------------------------------- endereço e login
# Nome DNS e IP fixo dados pela TI (o certificado vale para os dois)
SITE_HOSTNAME=apps-fabrica.seudominio.local
SITE_IP=10.0.0.50
ADMIN_USER=admin
# Gere com: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'SUA_SENHA'
# No .env, mantenha as ASPAS SIMPLES (o hash tem $ e o compose tentaria interpolar).
ADMIN_PASSWORD_HASH='$2a$14$TROQUE_PELO_HASH_GERADO'

# ---------------------------------------------------------------- imagens
# Onde o GitHub Actions publica as imagens (ver .github/workflows/build.yml)
REGISTRY=ghcr.io/fabioagc
TAG=latest

# ---------------------------------------------------------------- Historian (REST OData + NTLM)
HISTORIAN_BASE_URL=http://brpuwwhist1:32569/Historian/v2/ProcessValues
HISTORIAN_DOMAIN=GENMILLS
HISTORIAN_USER=svc_fabrica_apps
HISTORIAN_PASSWORD=

# ---------------------------------------------------------------- MES (API REST + OAuth2)
MES_BASE_URL=https://servidor-mes/mesmw
MES_TOKEN_URL=https://servidor-mes/identitymanager/connect/token
# Header Host, só se acessar o MES pelo IP (ex.: wt2.mes.local)
MES_HOST=
MES_CLIENT_ID=AIM_DefaultManagementClient
MES_CLIENT_SECRET=
MES_USERNAME=GENMILLS\svc_fabrica_apps
MES_PASSWORD=
# true quando a TI fornecer certificado válido para o MES
MES_VERIFY_TLS=false

# Consulta dos registros (usada pela tela de 7 dias E pela ETL).
# Caminho relativo a MES_BASE_URL e parâmetros em JSON; {inicio} e {fim} viram ISO 8601.
# Exemplo com DirectAccess (troque pelo procedimento/endpoint real):
MES_REGISTROS_PATH=/api/v3/DirectAccess
MES_REGISTROS_PARAMS='{"spName":"NOME_DO_PROCEDIMENTO","spParams":"[{\"name\":\"start_time\",\"value\":\"{inicio}\"},{\"name\":\"end_time\",\"value\":\"{fim}\"}]"}'
# Coluna de data/hora de cada registro (usada no corte de 7 dias e na janela da ETL)
MES_COLUNA_DATA=EventTime
MES_REFRESH_MIN=10

# ---------------------------------------------------------------- ETL MES -> Snowflake
ETL_INTERVAL_MIN=60
ETL_INITIAL_DAYS=7
ETL_OVERLAP_HOURS=6
ETL_CHUNK_HOURS=24
ETL_TARGET_TABLE=MES_REGISTROS
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Chave privada (key-pair auth) em base64 numa linha só: base64 -w0 rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_B64=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---------------------------------------------------------------- OCR local
OLLAMA_MODEL=qwen2.5:3b
# auto = tenta logprobs e cai para confiança verbal se o Ollama não devolver
LLM_MODE=auto

# ---------------------------------------------------------------- MCP do MES
# Gere com: openssl rand -hex 32
MCP_API_KEY=

# ---------------------------------------------------------------- DIMEP
DIMEP_DB_SERVER=
DIMEP_DB_NAME=DMPACESSOII
DIMEP_DB_USER=
DIMEP_DB_PASSWORD=
DIMEP_DB_EXTRA=Encrypt=yes;TrustServerCertificate=yes;
